+        Stage::Confirm101 => (
+            Some(parse_sha("MAMBA_FIXED_ADA_SCREEN_SHA")?),
+            Some(parse_sha("MAMBA_FIXED_ADA_SCREEN_ARTIFACT_SHA")?),
+        ),
