+fn parse_config(environment: &BTreeMap<String, String>) -> Result<Config, String> {
+    const ALLOWED: [&str; 16] = [
+        "MAMBA_FIXED_ADA_TOOLKIT_ADMISSION",
+        "MAMBA_FIXED_ADA_VENDOR",
+        "MAMBA_FIXED_ADA_ROWS",
