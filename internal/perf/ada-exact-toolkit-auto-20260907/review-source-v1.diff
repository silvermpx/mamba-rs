+        ("MAMBA_FIXED_ADA_VENDOR", "1"),
+        ("MAMBA_FIXED_ADA_EXACT_POST_TUNING_REVISION", "44"),
+        ("MAMBA_FIXED_VENDOR_TILES", "Legacy,F32Sm89N64CopyPlan"),
+        ("MAMBA_FIXED_VENDOR_PATHS", "eager,graph"),
+        ("MAMBA_FIXED_VENDOR_EXACT_CC", "8.9"),
